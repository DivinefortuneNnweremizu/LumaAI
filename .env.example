# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luma?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/luma?schema=public

# Authentication & Storage (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Provider (Deepseek)
DEEPSEEK_API_KEY=your-deepseek-api-key

# Billing (Flutterwave)
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxx
FLW_WEBHOOK_SECRET=your-webhook-secret
FLW_ENCRYPTION_KEY=your-flw-encryption-key

# Email
RESEND_API_KEY=re_your_resend_api_key

# Analytics & Error Monitoring
POSTHOG_KEY=phc_your_posthog_key
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io
